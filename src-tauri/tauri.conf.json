{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A Guilda VTT",
  "version": "0.0.1",
  "identifier": "br.com.tormentavtt.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "A Guilda VTT",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["nsis"] }
}
